<!DOCTYPE html>
<html>
<head><title>Video Call</title><link rel="stylesheet" href="style.css"></head>
<body>
<div class="container">
  <div class="video-container">
    <video id="remoteVideo" autoplay playsinline></video>
    <div class="timer" id="timer">00:00 | Minutes Left: <span id="minLeft">--</span></div>
    <button class="blur-toggle" id="blurToggle" style="display:none">🔒 Safe Mode: OFF</button>
  </div>

  <div class="controls">
    <button class="btn btn-gray" id="btnNext">⏭ NEXT</button>
    <button class="btn btn-danger" id="btnEnd">📞 END</button>
    <button class="btn btn-star" id="btnFav" onclick="toggleFav()">⭐</button>
  </div>

  <div class="card">
    <h3>💬 Chat</h3>
    <div id="chatBox" style="height:180px; overflow-y:auto; margin-bottom:12px"></div>
    <div id="chatLocked" class="locked">🔒 Messages unlock at 800 total minutes</div>
    <div id="chatInput" style="display:none">
      <input type="text" id="msgText" placeholder="Type message...">
      <button class="btn btn-primary" onclick="sendMessage()">Send</button>
    </div>
  </div>
</div>

<script>
const token = localStorage.getItem('token');
const callId = localStorage.getItem('activeCallId');
const role = localStorage.getItem('role');
let startTime = Date.now();
let blurEnabled = false;

// Show blur toggle to women
if(role==='earner') document.getElementById('blurToggle').style.display='block';

// Timer
setInterval(()=>{
  const m = Math.floor((Date.now()-startTime)/60000);
  const s = Math.floor(((Date.now()-startTime)%60000)/1000);
  document.getElementById('timer').innerHTML = 
    `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')} | Minutes Left: --`;
},1000);

// Blur toggle
document.getElementById('blurToggle').onclick = ()=>{
  blurEnabled = !blurEnabled;
  document.getElementById('blurToggle').textContent = blurEnabled?'🔒 Safe Mode: ON':'🔒 Safe Mode: OFF';
  document.getElementById('remoteVideo').style.filter = blurEnabled?'blur(25px)':'none';
};

// End call
document.getElementById('btnEnd').onclick = async ()=>{
  await fetch(`/call/${callId}/end`, {method:'POST', headers:{Authorization:`Bearer ${token}`}});
  localStorage.removeItem('activeCallId');
  location.href='dashboard.html';
};

// Next
document.getElementById('btnNext').onclick = async ()=>{
  await fetch(`/call/${callId}/next`, {method:'POST', headers:{Authorization:`Bearer ${token}`}});
  location.reload();
};

// Check chat unlock
window.onload = async ()=>{
  const res = await fetch('/api/me', {headers:{Authorization:`Bearer ${token}`}});
  const me = await res.json();
  if(role==='earner' || me.totalMinutesSpent >= 800){
    document.getElementById('chatLocked').style.display='none';
    document.getElementById('chatInput').style.display='block';
  }
};

async function sendMessage(){
  const text = document.getElementById('msgText').value.trim();
  if(!text) return;
  const res = await fetch(`/message/${callId}`, {
    method:'POST', headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},
    body:JSON.stringify({text})
  });
  const d = await res.json();
  if(d.error) alert(d.error);
  else {
    document.getElementById('chatBox').innerHTML += `<div><strong>You:</strong> ${text}</div>`;
    document.getElementById('msgText').value='';
    document.getElementById('chatBox').scrollTop = document.getElementById('chatBox').scrollHeight;
  }
}

async function toggleFav(){
  const earner = JSON.parse(localStorage.getItem('activeEarner'));
  await fetch(`/favorites/${earner.id}`, {method:'POST', headers:{Authorization:`Bearer ${token}`}});
  alert('⭐ Added to Favorites!');
}
</script>
</body>
</html>