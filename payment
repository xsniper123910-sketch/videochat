require('dotenv').config();
const express = require('express');
const mongoose = require('mongoose');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const cors = require('cors');
const axios = require('axios');
const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);
const cron = require('node-cron');

const app = express();
app.use(cors());

// === RAW BODY FOR STRIPE WEBHOOK ===
app.use('/webhook/stripe', express.raw({ type: 'application/json' }));
app.use(express.json());
app.use(express.static('public'));

const PORT = process.env.PORT || 5000;

// === DATABASE CONNECTION ===
mongoose.connect(process.env.MONGO_URI)
  .then(() => console.log('✅ Connected to MongoDB'))
  .catch(err => console.error('❌ MongoDB Error:', err));

// === USER MODEL ===
const UserSchema = new mongoose.Schema({
  role: { type: String, enum: ['payer', 'earner'], required: true },
  email: { type: String, unique: true, required: true },
  passwordHash: { type: String, required: true },
  fullName: String,
  address: String,
  city: String,
  country: String,
  verification: {
    idPhoto: String,
    selfie: String,
    proofOfResidence: String,
    faceMatchScore: Number,
    status: { type: String, enum: ['pending', 'approved', 'rejected'], default: 'pending' }
  },
  remainingMinutes: { type: Number, default: 0 },
  totalMinutesSpent: { type: Number, default: 0 },
  earningsBalance: { type: Number, default: 0 },
  payoutMethod: { type: String, enum: ['stripe', 'bitcoin'], default: 'stripe' },
  bitcoinWallet: String,
  stripeAccountId: String,
  lastPayoutDate: Date,
  favorites: [{ type: mongoose.Schema.Types.ObjectId, ref: 'User' }],
  online: { type: Boolean, default: false },
  inCall: { type: Boolean, default: false },
  createdAt: { type: Date, default: Date.now }
});
const User = mongoose.model('User', UserSchema);

const CallSchema = new mongoose.Schema({
  payer: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
  earner: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
  planId: String,
  startTime: Date,
  endTime: Date,
  active: Boolean,
  minutesUsed: { type: Number, default: 0 }
});
const Call = mongoose.model('Call', CallSchema);

const MessageSchema = new mongoose.Schema({
  from: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
  to: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
  text: String,
  translatedText: String,
  timestamp: { type: Date, default: Date.now }
});
const Message = mongoose.model('Message', MessageSchema);

// === PRICING & RULES ===
const PLANS = {
  '20min': { minutes: 20, price: 15.00 },
  '45min': { minutes: 45, price: 39.00 },
  '100min': { minutes: 100, price: 95.00 }
};
const COMMISSION = 0.30;
const EARNER_SHARE = 0.70;
const CHAT_UNLOCK_MIN = 800;

// === AUTH MIDDLEWARE ===
const auth = (req, res, next) => {
  try {
    const token = req.headers.authorization?.split(' ')[1];
    if (!token) return res.status(401).json({ error: 'Unauthorized' });
    req.user = jwt.verify(token, process.env.JWT_SECRET);
    next();
  } catch { res.status(401).json({ error: 'Invalid token' }); }
};

// === HELPER: Payout Method by Country ===
function getPayoutMethodForCountry(country) {
  const c = country?.toUpperCase();
  if (c === 'UA' || c === 'UKRAINE' || c === 'RU' || c === 'RUSSIA') return 'bitcoin';
  return 'stripe';
}

// === HEALTH CHECK ===
app.get('/api/health', (req, res) => res.json({ status: 'ok' }));

// === REGISTER ===
app.post('/register', async (req, res) => {
  try {
    const { role, email, password, country, ...data } = req.body;
    const passwordHash = await bcrypt.hash(password, 12);

    if (role === 'payer') {
      const user = await User.create({ role, email, passwordHash, 'verification.status': 'approved' });
      return res.json({ success: true, token: jwt.sign({ id: user._id, role }, process.env.JWT_SECRET, { expiresIn: '30d' }), role: 'payer' });
    }

    if (role === 'earner') {
      const payoutMethod = getPayoutMethodForCountry(country);
      const faceMatchScore = 90;
      if (faceMatchScore < 85) return res.status(400).json({ error: 'Face does not match ID' });

      const user = await User.create({
        role, email, passwordHash, country, payoutMethod, ...data,
        'verification.faceMatchScore': faceMatchScore,
        'verification.status': 'pending'
      });
      return res.json({ success: true, message: 'Account created — waiting admin approval', payoutMethod });
    }
  } catch (e) { res.status(400).json({ error: e.message }); }
});

// === LOGIN ===
app.post('/login', async (req, res) => {
  const { email, password } = req.body;
  const user = await User.findOne({ email });
  if (!user || !await bcrypt.compare(password, user.passwordHash))
    return res.status(401).json({ error: 'Invalid email or password' });
  if (user.role === 'earner' && user.verification.status !== 'approved')
    return res.status(403).json({ error: 'Account not verified yet. Please wait for approval.' });

  res.json({
    success: true,
    token: jwt.sign({ id: user._id, role: user.role }, process.env.JWT_SECRET, { expiresIn: '30d' }),
    user: {
      id: user._id, role: user.role, email: user.email,
      remainingMinutes: user.remainingMinutes,
      totalMinutesSpent: user.totalMinutesSpent,
      earningsBalance: user.earningsBalance,
      payoutMethod: user.payoutMethod,
      bitcoinWallet: user.bitcoinWallet,
      verified: user.verification.status
    }
  });
});

// === STRIPE CHECKOUT ===
app.post('/create-checkout-session', auth, async (req, res) => {
  try {
    const { planId } = req.body;
    const plan = PLANS[planId];
    if (!plan || req.user.role !== 'payer') return res.status(400).json({ error: 'Invalid plan' });

    const session = await stripe.checkout.sessions.create({
      payment_method_types: ['card'],
      mode: 'payment',
      customer_email: req.user.email,
      line_items: [{
        price_data: {
          currency: 'gbp',
          product_data: { name: `${plan.minutes} Minutes Pack`, description: 'Video Call Time' },
          unit_amount: Math.round(plan.price * 100)
        },
        quantity: 1
      }],
      metadata: { userId: req.user.id, planId, minutes: plan.minutes },
      success_url: `${process.env.BASE_URL}/success.html?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${process.env.BASE_URL}/dashboard.html`
    });
    res.json({ sessionUrl: session.url });
  } catch (e) { res.status(500).json({ error: e.message }); }
});

// === STRIPE WEBHOOK ===
app.post('/webhook/stripe', async (req, res) => {
  const sig = req.headers['stripe-signature'];
  let event;
  try {
    event = stripe.webhooks.constructEvent(req.body, sig, process.env.STRIPE_WEBHOOK_SECRET);
  } catch (err) return res.status(400).send(`Webhook Error: ${err.message}`);

  if (event.type === 'checkout.session.completed') {
    const session = event.data.object;
    const { userId, minutes } = session.metadata;
    await User.findByIdAndUpdate(userId, { $inc: { remainingMinutes: parseInt(minutes) } });
    console.log(`✅ Payment — ${minutes} min added to user ${userId}`);
  }
  res.json({ received: true });
});

// === VERIFY PAYMENT ===
app.get('/verify-payment', async (req, res) => {
  try {
    const session = await stripe.checkout.sessions.retrieve(req.query.session_id);
    res.json({ success: session.payment_status === 'paid', minutes: session.metadata?.minutes });
  } catch { res.json({ success: false }); }
});

// === MATCHING ===
app.post('/match', auth, async (req, res) => {
  if (req.user.role !== 'payer') return res.status(403).json({ error: 'Not allowed' });
  const payer = await User.findById(req.user.id);
  if (payer.remainingMinutes < 1) return res.status(400).json({ error: '⚠️ Buy minutes first' });

  const earners = await User.find({ role: 'earner', 'verification.status': 'approved', online: true, inCall: false });
  if (!earners.length) return res.json({ error: 'No women available online right now' });

  const earner = earners[Math.floor(Math.random() * earners.length)];
  const call = await Call.create({ payer: req.user.id, earner: earner._id, planId: '20min', startTime: Date.now(), active: true });
  await User.findByIdAndUpdate(req.user.id, { inCall: true });
  await User.findByIdAndUpdate(earner._id, { inCall: true });
  res.json({ success: true, callId: call._id, earner: { id: earner._id, name: earner.fullName || earner.email } });
});

// === END CALL / BILLING ===
async function endCallLogic(callId) {
  const call = await Call.findById(callId);
  if (!call || !call.active) return;

  const minutesUsed = Math.max(1, Math.ceil((Date.now() - call.startTime) / 60000));
  call.active = false; call.endTime = Date.now(); call.minutesUsed = minutesUsed;
  await call.save();

  const plan = PLANS[call.planId] || PLANS['20min'];
  const perMinPrice = plan.price / plan.minutes;
  const earnerEarnings = perMinPrice * EARNER_SHARE * minutesUsed;

  await User.findByIdAndUpdate(call.payer, {
    $inc: { remainingMinutes: -minutesUsed, totalMinutesSpent: minutesUsed },
    inCall: false
  });

  await User.findByIdAndUpdate(call.earner, {
    $inc: { earningsBalance: earnerEarnings },
    inCall: false
  });
}

app.post('/call/:id/end', auth, async (req, res) => { await endCallLogic(req.params.id); res.json({ success: true }); });
app.post('/call/:id/next', auth, async (req, res) => { await endCallLogic(req.params.id); res.json({ success: true }); });

// === SET BTC WALLET ===
app.post('/set-bitcoin-wallet', auth, async (req, res) => {
  if (req.user.role !== 'earner') return res.status(403).json({ error: 'Not allowed' });
  const { bitcoinWallet } = req.body;
  if (!/^[13][a-km-zA-HJ-NP-Z1-9]{25,34}$|^bc1[ac-hj-np-zAC-HJ-NP-Z02-9]{11,71}$/.test(bitcoinWallet))
    return res.status(400).json({ error: 'Invalid Bitcoin wallet address' });

  await User.findByIdAndUpdate(req.user.id, { bitcoinWallet });
  res.json({ success: true, bitcoinWallet });
});

