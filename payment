// === FAVORITES, ONLINE, MESSAGES, PROFILE ===
app.post('/favorites/:tid', auth, async (req, res) => {
  await User.findByIdAndUpdate(req.user.id, { $addToSet: { favorites: req.params.tid } });
  res.json({ success: true });
});

app.post('/online', auth, async (req, res) => {
  await User.findByIdAndUpdate(req.user.id, { online: req.body.online });
  res.json({ success: true });
});

app.get('/api/me', auth, async (req, res) => {
  const u = await User.findById(req.user.id).select('-passwordHash');
  res.json(u);
});

app.post('/message/:toId', auth, async (req, res) => {
  const { text } = req.body;
  const sender = await User.findById(req.user.id);
  if (req.user.role === 'payer' && sender.totalMinutesSpent < CHAT_UNLOCK_MIN)
    return res.status(403).json({ error: `🔒 Unlocks at ${CHAT_UNLOCK_MIN}min. Need ${CHAT_UNLOCK_MIN - sender.totalMinutesSpent} more.` });
  if (/(\.(jpg|png|gif|mp4|webm)|http:|https:|<img|<video)/i.test(text))
    return res.status(400).json({ error: '❌ Text only — no media or links' });

  let translatedText = text;
  try {
    const tr = await axios.post('https://api-free.deepl.com/v2/translate', new URLSearchParams({
      auth_key: process.env.DEEPL_API_KEY, text, target_lang: 'EN'
    }));
    translatedText = tr.data.translations[0].text;
  } catch {}

  const msg = await Message.create({ from: req.user.id, to: req.params.toId, text, translatedText });
  res.json({ success: true, message: msg });
});

app.listen(PORT, () => console.log(`🚀 LIVE on port ${PORT}`));