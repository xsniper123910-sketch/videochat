<!DOCTYPE html>
<html>
<head><title>Payment Successful</title><link rel="stylesheet" href="style.css"></head>
<body>
<div class="container">
  <div class="card" style="max-width:500px; margin:40px auto; text-align:center">
    <h1>✅ Payment Successful!</h1>
    <p id="msg">Adding minutes to your account...</p>
    <button class="btn btn-primary" onclick="location.href='dashboard.html'" style="margin-top:20px">Go to Dashboard</button>
  </div>
</div>
<script>
async function verify(){
  const p = new URLSearchParams(window.location.search);
  const res = await fetch(`/verify-payment?session_id=${p.get('session_id')}`);
  const d = await res.json();
  document.getElementById('msg').innerHTML = d.success
    ? `🎉 <strong>${d.minutes} minutes</strong> added to your account!`
    : '⚠️ Payment processing. Refresh dashboard in 1 minute.';
}
verify();
</script>
</body>
</html>