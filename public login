    if(!idPhoto || !selfie || !proofOfResidence){ msgBox.innerHTML='<div class="error">❌ Upload all 3 photos</div>'; return; }
    try {
        const res = await fetch('/register', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ role: 'earner', username, email, password, fullName, address, city, country, idPhoto, selfie, proofOfResidence })
        });
        const d = await res.json();
