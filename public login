async function doLogin(e){
    e.preventDefault();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const msgBox = document.getElementById('msgBox');

    if(!email || !email.includes('@')) return msgBox.innerHTML='<div class="error">❌ Enter valid email</div>';
    if(password.length < 6) return msgBox.innerHTML='<div class="error">❌ Enter password</div>';

    try {
        const res = await fetch('/login', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ email, password })
        });
        const d = await res.json();
        if(d.success){
            localStorage.setItem('token', d.token);
            localStorage.setItem('role', d.role);
            localStorage.setItem('isAdmin', d.isAdmin ? 'true' : 'false');
            localStorage.setItem('userEmail', email); // ← SAVE EMAIL FOR DASHBOARD
            window.location.href = 'dashboard.html'; // ← REDIRECT TO CAMERA PAGE!
        } else {
            msgBox.innerHTML = '<div class="error">❌ ' + (d.error || 'Login failed') + '</div>';
        }
    } catch(err) {
        msgBox.innerHTML = '<div class="error">❌ Server error. Try again.</div>';
    }
}
