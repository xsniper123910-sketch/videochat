<!DOCTYPE html>
<html>
<head><title>Dashboard</title><link rel="stylesheet" href="style.css"></head>
<body>
<div class="container">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px">
    <h1>🎥 Dashboard</h1>
    <button class="btn btn-gray" onclick="logout()">Logout</button>
  </div>

  <div class="card">
    <h3>👤 My Account</h3>
    <p>Minutes Remaining: <strong id="myMins">0</strong></p>
    <p>Total Minutes Used: <strong id="totalMins">0</strong></p>
    <p id="earningsLine" style="display:none">💰 Earnings Balance: £<strong id="earningsBal">0.00</strong></p>
    <p id="payoutMethod"></p>
  </div>

  <!-- BUY MINUTES (Men) -->
  <div class="card" id="buySection">
    <h2>💳 Buy Minutes — Visa / Mastercard</h2>
    <div class="grid">
      <div class="bundle-card" onclick="buyPlan('20min')">
        <h3>20 Minutes</h3><p>£15.00</p>
        <button class="btn btn-primary">Buy Now</button>
      </div>
      <div class="bundle-card" onclick="buyPlan('45min')">
        <h3>45 Minutes</h3><p>£39.00</p>
        <button class="btn btn-primary">Buy Now</button>
      </div>
      <div class="bundle-card" onclick="buyPlan('100min')">
        <h3>100 Minutes</h3><p>£95.00</p>
        <button class="btn btn-primary">Buy Now</button>
      </div>
    </div>
  </div>

  <!-- BTC WALLET (Ukraine/Russia Women) -->
  <div class="card" id="btcSection" style="display:none">
    <h2>₿ Bitcoin Payout Wallet</h2>
    <p>Since you are in Ukraine/Russia, earnings are paid in Bitcoin every Monday.</p>
    <input type="text" id="btcWalletAddr" placeholder="Your Bitcoin Wallet Address">
    <button class="btn btn-primary" onclick="saveBtcWallet()">Save Wallet</button>
    <p id="walletStatus"></p>
    <p><strong>Next payout:</strong> Every Monday automatically</p>
  </div>

  <!-- START CALL (Men) -->
  <div class="card" id="callSection">
    <button class="btn btn-primary" style="width:100%; font-size:20px; padding:20px" onclick="startMatch()">
      🎬 START — Find Match
    </button>
  </div>

  <!-- GO ONLINE (Women) -->
  <div class="card" id="onlineSection" style="display:none">
    <label style="font-size:18px; cursor:pointer">
      <input type="checkbox" id="goOnline"> Go Online to receive calls & earn money
    </label>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
const token = localStorage.getItem('token');
const role = localStorage.getItem('role');
const stripe = Stripe('pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY');
let me = null;

window.onload = async ()=>{
  if(!token) return location.href='login.html';
  const res = await fetch('/api/me', {headers:{Authorization:`Bearer ${token}`}});
  me = await res.json();
  document.getElementById('myMins').textContent = me.remainingMinutes;
  document.getElementById('totalMins').textContent = me.totalMinutesSpent;

  if(role==='earner'){
    document.getElementById('buySection').style.display='none';
    document.getElementById('callSection').style.display='none';
    document.getElementById('onlineSection').style.display='block';
    document.getElementById('earningsLine').style.display='block';
    document.getElementById('earningsBal').textContent = (me.earningsBalance||0).toFixed(2);
    document.getElementById('payoutMethod').textContent = `Payout Method: ${me.payoutMethod}`;
    if(me.payoutMethod==='bitcoin'){
      document.getElementById('btcSection').style.display='block';
      if(me.bitcoinWallet){
        document.getElementById('btcWalletAddr').value = me.bitcoinWallet;
        document.getElementById('walletStatus').innerHTML='✅ Wallet saved';
      }
    }
    document.getElementById('goOnline').onchange = async e=>{
      await fetch('/online', {method:'POST', headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'}, body:JSON.stringify({online:e.target.checked})});
    };
  }
};

async function buyPlan(planId){
  const res = await fetch('/create-checkout-session', {
    method:'POST', headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},
    body:JSON.stringify({planId})
  });
  const d = await res.json();
  if(d.sessionUrl) window.location.href=d.sessionUrl;
  else alert(d.error);
}

async function saveBtcWallet(){
  const res = await fetch('/set-bitcoin-wallet', {
    method:'POST', headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},
    body:JSON.stringify({bitcoinWallet:document.getElementById('btcWalletAddr').value.trim()})
  });
  const d = await res.json();
  alert(d.success?'✅ Wallet saved!':d.error);
}

async function startMatch(){
  const res = await fetch('/match', {method:'POST', headers:{Authorization:`Bearer ${token}`}});
  const d = await res.json();
  if(d.success){
    localStorage.setItem('activeCallId',d.callId);
    localStorage.setItem('activeEarner',JSON.stringify(d.earner));
    location.href='room.html';
  }else alert(d.error);
}

function logout(){
  localStorage.clear();
  location.href='login.html';
}
</script>
</body>
</html>