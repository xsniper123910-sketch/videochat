<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flitry — Video Chat</title>
    <link rel="stylesheet" href="style.css">
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif}
        body{background:linear-gradient(135deg,#0F0F23 0%,#1A1A3A 50%,#251640 100%);min-height:100vh;color:white}
        .top-bar{background:rgba(0,0,0,0.3);padding:12px 24px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.1)}
        .logo-text{font-size:24px;font-weight:800;background:linear-gradient(90deg,#FF6B9D,#9D65FF);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .coins-display{background:linear-gradient(135deg,#FACC15,#F59E0B);color:black;padding:8px 16px;border-radius:20px;font-weight:700}
        .container{max-width:1200px;margin:0 auto;padding:20px}
        .video-container{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0}
        @media(max-width:768px){.video-container{grid-template-columns:1fr}}
        .video-box{background:#000;border-radius:20px;aspect-ratio:16/9;overflow:hidden;position:relative;border:3px solid transparent}
        video{width:100%;height:100%;object-fit:cover;background:#111}
        .video-label{position:absolute;top:12px;left:12px;background:rgba(0,0,0,0.7);padding:6px 12px;border-radius:20px;font-size:14px;font-weight:600}
        .status-box{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;color:#aaa}
        .controls{display:flex;justify-content:center;gap:16px;margin:24px 0;flex-wrap:wrap}
        .ctrl-btn{padding:16px 32px;border-radius:50px;border:none;font-size:18px;font-weight:700;cursor:pointer;transition:all 0.2s;min-width:140px}
        .ctrl-btn:hover{transform:scale(1.05)}
        .btn-start{background:linear-gradient(135deg,#10B981,#34D399);color:white}
        .btn-next{background:linear-gradient(135deg,#6366F1,#8B5CF6);color:white}
        .btn-end{background:linear-gradient(135deg,#EF4444,#F87171);color:white}
        .btn-hub{background:linear-gradient(135deg,#FACC15,#F59E0B);color:black}
        .ctrl-btn:disabled{opacity:0.4;cursor:not-allowed;transform:none}
        .hidden{display:none !important}
        .modal{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);display:none;align-items:center;justify-content:center;z-index:9999;padding:20px}
        .modal.active{display:flex}
        .modal-content{background:linear-gradient(135deg,#1A1A3A,#251640);border-radius:24px;padding:30px;max-width:500px;width:100%;border:1px solid rgba(255,255,255,0.1)}
        .tab-buttons{display:flex;gap:10px;margin-bottom:20px}
        .tab-btn{flex:1;padding:10px;border-radius:10px;border:none;background:#2A2A4A;color:white;cursor:pointer}
        .tab-btn.active{background:linear-gradient(135deg,#6366F1,#EC4899)}
        .tab-content{display:none}
        .tab-content.active{display:block}
        .coin-package{background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;margin:10px 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
        .coin-package:hover{background:rgba(255,255,255,0.1)}
        .support-box{background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;margin:10px 0}
        .support-box input,.support-box textarea{width:100%;padding:12px;border-radius:8px;border:1px solid #444;background:#112;color:white;margin:6px 0}
        .call-status{text-align:center;margin-top:20px;font-size:18px}
        .admin-badge{background:linear-gradient(135deg,#FACC15,#F59E0B);color:black;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:700;margin-left:10px}
        .user-area{display:flex;align-items:center;gap:12px}
    </style>
</head>
<body>

<!-- HUB MODAL -->
<div class="modal" id="hubModal">
    <div class="modal-content">
        <h2 style="text-align:center;margin-bottom:20px">⚡ FLITRY HUB</h2>
        <div class="tab-buttons">
            <button class="tab-btn active" onclick="openTab('coins')">💰 Buy Coins</button>
            <button class="tab-btn" onclick="openTab('support')">💬 Support</button>
        </div>
        <div class="tab-content active" id="tabCoins">
            <p style="color:#999;margin-bottom:10px">Coins let you connect with new people!</p>
            <div class="coin-package" onclick="buyCoins('small')">
                <div><strong>100 Coins</strong></div><div style="color:#FACC15;font-weight:700">$4.99</div>
            </div>
            <div class="coin-package" onclick="buyCoins('medium')">
                <div><strong>500 Coins ⭐</strong></div><div style="color:#FACC15;font-weight:700">$19.99</div>
            </div>
            <div class="coin-package" onclick="buyCoins('large')">
                <div><strong>1,500 Coins 💎</strong></div><div style="color:#FACC15;font-weight:700">$49.99</div>
            </div>
            <div class="coin-package" onclick="buyCoins('mega')">
                <div><strong>5,000 Coins 👑</strong></div><div style="color:#FACC15;font-weight:700">$149.99</div>
            </div>
            <p id="buyMsg" style="text-align:center;margin-top:12px"></p>
        </div>
        <div class="tab-content" id="tabSupport">
            <p style="color:#999;margin-bottom:10px">Need help? Contact us!</p>
            <div class="support-box">
                <input type="text" id="sName" placeholder="Your Name">
                <input type="email" id="sEmail" placeholder="Your Email">
                <textarea id="sMsg" rows="4" placeholder="Your message..."></textarea>
                <button onclick="sendSupport()" style="width:100%;padding:12px;border-radius:8px;border:none;background:linear-gradient(135deg,#EC4899,#6366F1);color:white;font-weight:600;margin-top:8px">📤 Send</button>
                <p id="sStatus" style="text-align:center;margin-top:10px"></p>
            </div>
        </div>
        <div style="text-align:center;margin-top:16px"><button onclick="closeHub()" style="padding:10px 30px;border-radius:10px;border:none;background:#475569;color:white;cursor:pointer">Close</button></div>
    </div>
</div>

<!-- TOP BAR -->
<div class="top-bar">
    <div class="logo-text">FLITRY</div>
    <div class="user-area">
        <span id="userName"></span>
        <span id="adminBadge" class="admin-badge hidden">👑 ADMIN</span>
        <span class="coins-display">💰 <span id="coinCount">0</span></span>
        <button onclick="openHub()" style="background:none;border:none;color:#FACC15;cursor:pointer">⚡ Hub</button>
        <button onclick="logout()" style="background:none;border:none;color:#999;cursor:pointer">Logout</button>
    </div>
</div>

<!-- MAIN CAMERA PAGE -->
<div class="container">
    <div class="video-container">
        <div class="video-box">
            <div class="video-label">You</div>
            <video id="localVideo" autoplay muted playsinline></video>
            <div id="localStatus" class="status-box">📷 Camera loading...</div>
        </div>
        <div class="video-box">
            <div class="video-label">Partner</div>
            <video id="remoteVideo" autoplay playsinline></video>
            <div id="remoteStatus" class="status-box">👋 Click Find Partner to start</div>
        </div>
    </div>

    <div class="controls">
        <button class="ctrl-btn btn-start" id="findBtn" onclick="findPartner()">🔍 Find Partner</button>
        <button class="ctrl-btn btn-next hidden" id="nextBtn" onclick="nextPartner()">➡️ Next</button>
        <button class="ctrl-btn btn-end hidden" id="endBtn" onclick="endCall()">📞 End</button>
    </div>

    <div id="callStatus" class="call-status"></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();
let localStream = null, peer = null, user = null, partnerSocketId = null;
const ICE = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

window.onload = async () => {
  const email = localStorage.getItem('userEmail');
  const token = localStorage.getItem('token');
  if (!email || !token) {
    alert('⚠️ Please register & login first!');
    window.location.href = 'register.html';
    return;
  }

  // Load user data
  const res = await fetch('/user-info', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({email})
  });
  const data = await res.json();
  if (!data.success) { logout(); return; }
  
  user = { email, username: data.username, role: data.role, coins: data.coins };
  document.getElementById('userName').textContent = '@' + user.username;
  document.getElementById('coinCount').textContent = user.coins;
  if (localStorage.getItem('isAdmin') === 'true') {
    document.getElementById('adminBadge').classList.remove('hidden');
  }

  // ✅ CAMERA ONLY STARTS AFTER LOGIN!
  try {
    localStream = await navigator.mediaDevices.getUserMedia({video:true,audio:true});
    document.getElementById('localVideo').srcObject = localStream;
    document.getElementById('localStatus').style.display = 'none';
  } catch(e) {
    document.getElementById('localStatus').innerHTML = '⚠️ Camera access denied';
  }
};

// 🔍 FIND PARTNER
async function findPartner(){
  if (!user) return;
  if (user.coins < 10) {
    alert('❌ Need at least 10 coins! Open Hub to buy more.');
    openHub(); return;
  }
  document.getElementById('callStatus').textContent = '⏳ Searching...';
  document.getElementById('remoteStatus').textContent = '🔍 Looking for someone...';
  updateButtons('searching');
  socket.emit('find-partner', {email:user.email,role:user.role,username:user.username});
}

// ✅ PARTNER FOUND!
socket.on('partner-found', async (data) => {
  partnerSocketId = data.partnerId;
  document.getElementById('callStatus').innerHTML = '✅ Connected with <strong>' + data.partner + '</strong>';
  document.getElementById('remoteStatus').style.display = 'none';
  updateButtons('connected');
  await deductCoins(10);
  await startPeerConnection();
});

// ⏳ WAITING
socket.on('waiting', () => {
  document.getElementById('callStatus').textContent = '⏳ Waiting for someone...';
});

// 📡 WEBRTC CONNECTION
async function startPeerConnection(){
  peer = new RTCPeerConnection(ICE);
  localStream.getTracks().forEach(t => peer.addTrack(t, localStream));
  
  peer.ontrack = e => {
    document.getElementById('remoteVideo').srcObject = e.streams[0];
  };
  peer.onicecandidate = e => {
    if (e.candidate) socket.emit('signal', {to:partnerSocketId, signal:{candidate:e.candidate}});
  };

  // If you joined first → create offer
  if (partnerSocketId) {
    const offer = await peer.createOffer();
    await peer.setLocalDescription(offer);
    socket.emit('signal', {to:partnerSocketId, signal:{offer}});
  }
}

// 📡 SIGNAL HANDLING
socket.on('signal', async data => {
  partnerSocketId = data.from;
  if (!peer) await startPeerConnection();
  
  if (data.signal.offer) {
    await peer.setRemoteDescription(new RTCSessionDescription(data.signal.offer));
    const ans = await peer.createAnswer();
    await peer.setLocalDescription(ans);
    socket.emit('signal', {to:data.from, signal:{answer:ans}});
  } else if (data.signal.answer) {
    await peer.setRemoteDescription(new RTCSessionDescription(data.signal.answer));
  } else if (data.signal.candidate) {
    await peer.addIceCandidate(new RTCIceCandidate(data.signal.candidate));
  }
});

// ➡️ NEXT PARTNER
async function nextPartner(){
  if (user.coins < 10) { alert('❌ Need 10 coins!'); return; }
  endCall(true);
  await deductCoins(10);
  findPartner();
}

// 📞 END CALL
function endCall(skip = false){
  if (peer) peer.close(); peer = null;
  if (!skip) socket.emit('end-call');
  document.getElementById('remoteVideo').srcObject = null;
  document.getElementById('remoteStatus').style.display = 'flex';
  document.getElementById('remoteStatus').textContent = '👋 Call ended';
  document.getElementById('callStatus').textContent = '';
  partnerSocketId = null;
  updateButtons('idle');
}

// 👋 PARTNER ENDED
socket.on('call-ended', () => {
  endCall();
  document.getElementById('callStatus').textContent = '👋 Partner disconnected';
});

// 💰 DEDUCT COINS
async function deductCoins(amt){
  const r = await fetch('/deduct-coins', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({email:user.email, amount:amt})
  });
  const d = await r.json();
  if (d.success) { user.coins = d.remainingCoins; document.getElementById('coinCount').textContent = d.remainingCoins; }
}

// 🔘 BUTTON STATES
function updateButtons(state){
  document.getElementById('findBtn').classList.toggle('hidden', state!=='idle');
  document.getElementById('nextBtn').classList.toggle('hidden', state!=='connected');
  document.getElementById('endBtn').classList.toggle('hidden', state!=='connected');
}

// ⚡ HUB FUNCTIONS
function openHub(){ document.getElementById('hubModal').classList.add('active'); }
function closeHub(){ document.getElementById('hubModal').classList.remove('active'); }
function openTab(name){
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(t=>t.classList.remove('active'));
  document.getElementById('tab'+name.charAt(0).toUpperCase()+name.slice(1)).classList.add('active');
  event.target.classList.add('active');
}
async function buyCoins(pkg){
  const r = await fetch('/buy-coins', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({email:user.email, packageId:pkg})
  });
  const d = await r.json();
  if (d.success) {
    user.coins = d.newCoins;
    document.getElementById('coinCount').textContent = d.newCoins;
    document.getElementById('buyMsg').innerHTML = '<span style="color:#10B981">✅ +' + d.added + ' coins!</span>';
  } else {
    document.getElementById('buyMsg').innerHTML = '<span style="color:#EF4444">❌ Failed</span>';
  }
}
function sendSupport(){
  document.getElementById('sStatus').innerHTML = '<span style="color:#10B981">✅ Sent!</span>';
  document.getElementById('sName').value='';document.getElementById('sEmail').value='';document.getElementById('sMsg').value='';
}
function logout(){ localStorage.clear(); window.location.href='login.html'; }
</script>
</body>
</html>
