async function registerPayer(e){
    e.preventDefault();
    const msgBox = document.getElementById('msgPayer');
    msgBox.innerHTML = '<div style="color:#aaa">⏳ Creating account...</div>';

    const username = document.getElementById('mUsername').value.trim();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    if(!username){ msgBox.innerHTML='<div class="error">❌ Enter username</div>'; return; }
    if(!email || !email.includes('@')){ msgBox.innerHTML='<div class="error">❌ Enter valid email</div>'; return; }
    if(password.length < 6){ msgBox.innerHTML='<div class="error">❌ Password 6+ chars</div>'; return; }

    try {
        const res = await fetch('/register', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ role: 'payer', username, email, password })
        });
        const d = await res.json();
        if(d.success){
            msgBox.innerHTML = '<div class="success">✅ Created! Going to Login...</div>';
            setTimeout(() => window.location.href = 'login.html', 2000);
        } else {
            msgBox.innerHTML = '<div class="error">❌ ' + (d.error || 'Failed') + '</div>';
        }
    } catch(err) {
        msgBox.innerHTML = '<div class="error">❌ Network error — try again</div>';
        console.log(err);
    }
}

async function registerAdmin(e){
    e.preventDefault();
    const msgBox = document.getElementById('msgAdmin');
    msgBox.innerHTML = '<div style="color:#aaa">⏳ Creating admin...</div>';

    const adminCode = document.getElementById('aAdminCode').value;
    const username = document.getElementById('aUsername').value.trim();
    const email = document.getElementById('aEmail').value.trim();
    const pass1 = document.getElementById('aPassword').value;
    const pass2 = document.getElementById('aPassword2').value;

    if(!adminCode){ msgBox.innerHTML='<div class="error">❌ Enter admin code</div>'; return; }
    if(!username){ msgBox.innerHTML='<div class="error">❌ Enter username</div>'; return; }
    if(!email || !email.includes('@')){ msgBox.innerHTML='<div class="error">❌ Enter valid email</div>'; return; }
    if(pass1.length < 6){ msgBox.innerHTML='<div class="error">❌ Password 6+ chars</div>'; return; }
    if(pass1 !== pass2){ msgBox.innerHTML='<div class="error">❌ Passwords do not match</div>'; return; }

    try {
        const res = await fetch('/register', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ role: 'admin', adminCode, username, email, password: pass1 })
        });
        const d = await res.json();
        if(d.success){
            msgBox.innerHTML = '<div class="success">👑 Admin created! Going to Login...</div>';
            setTimeout(() => window.location.href = 'login.html', 2000);
        } else {
            msgBox.innerHTML = '<div class="error">❌ ' + (d.error || 'Failed') + '</div>';
        }
    } catch(err) {
        msgBox.innerHTML = '<div class="error">❌ Server error — try again</div>';
    }
}

async function registerEarner(e){
    e.preventDefault();
    const msgBox = document.getElementById('msgEarner');
    msgBox.innerHTML = '<div style="color:#aaa">⏳ Registering...</div>';

    const username = document.getElementById('wUsername').value.trim();
    const email = document.getElementById('eEmail').value.trim();
    const password = document.getElementById('ePassword').value;
    const fullName = document.getElementById('fullName').value.trim();
    const address = document.getElementById('address').value.trim();
    const city = document.getElementById('city').value.trim();
    const country = document.getElementById('country').value.trim();
    const idPhoto = document.getElementById('idPhoto').value;
    const selfie = document.getElementById('selfie').value;
    const proofOfResidence = document.getElementById('proofOfRes').value;

    if(!username || !email || !password){ msgBox.innerHTML='<div class="error">❌ Fill Step 1</div>'; return; }
    if(!fullName || !address || !city || !country){ msgBox.innerHTML='<div class="error">❌ Fill all details</div>'; return; }
    if(!idPhoto || !selfie || !proofOfResidence){ msgBox.innerHTML='<div class="error">❌ Upload all photos</div>'; return; }

    try {
        const res = await fetch('/register', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ role: 'earner', username, email, password, fullName, address, city, country, idPhoto, selfie, proofOfResidence })
        });
        const d = await res.json();
        if(d.success){
            msgBox.innerHTML = '<div class="success">✅ Registered! Wait for approval... Going to Login...</div>';
            setTimeout(() => window.location.href = 'login.html', 3000);
        } else {
            msgBox.innerHTML = '<div class="error">❌ ' + (d.error || 'Failed') + '</div>';
        }
    } catch(err) {
        msgBox.innerHTML = '<div class="error">❌ Server error — try again</div>';
    }
}
