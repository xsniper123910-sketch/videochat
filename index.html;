<!DOCTYPE html>
<html>
<head>
    <title>Flitry — Video Chat</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body {
            background: linear-gradient(135deg, #0F0F23 0%, #1A1A3A 50%, #251640 100%);
            font-family: 'Segoe UI', sans-serif;
            color: white;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .box {
            padding: 40px;
        }
        h1 {
            font-size: 48px;
            background: linear-gradient(90deg, #FF6B9D, #9D65FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
        }
        p {
            color: #aaa;
            font-size: 18px;
            margin-bottom: 30px;
        }
        .btn {
            display: inline-block;
            padding: 16px 40px;
            background: linear-gradient(135deg, #EC4899, #6366F1);
            color: white;
            font-size: 20px;
            font-weight: bold;
            border-radius: 50px;
            text-decoration: none;
            margin: 10px;
            transition: transform 0.2s;
        }
        .btn:hover { transform: scale(1.05); }
    </style>
</head>
<body>
    <div class="box">
        <h1>FLITRY</h1>
        <p>Meet new people through video chat</p>
        <a href="register.html" class="btn">📝 Register</a>
        <a href="login.html" class="btn">🔑 Login</a>
    </div>
</body>
</html>
